{
  "manifest_version": 3,
  "name": "Stream Frame Helper",
  "version": "1.7.0",
  "description": "Start page, Home button, controller mapping and send-from-phone for Stream Frame on the Steam Frame.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "home.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["settings.js", "input.js", "actions.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["bridge-netflix.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["home.html", "probe.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
