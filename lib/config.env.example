# Stream Frame settings: ~/.config/stream-frame/config.env
# Read by bin/stream-frame at every launch (bash syntax). Delete a line to use the default.

# Chrome backend: auto (Flatpak if installed, else the extracted .deb), flatpak, or deb.
CHROME_BACKEND=auto

# Chrome window size. 1280,720 matches gamescope's default panel size on SteamOS 0.3.0.
# If Phase 0 spike S3 finds a way to raise the panel to 1080p, set 1920,1080 here.
WINDOW_SIZE=1280,720

# Scale the page UI (for example 1.25) if text is too small on a 720p panel.
SCALE_FACTOR=

# Start somewhere other than the Stream Frame start page (full URL). Empty = start page.
START_URL=

# Experiment, off by default: present a ChromeOS user agent. Some services raise their
# resolution cap for ChromeOS. This is a terms-of-service grey area; use at your own risk.
UA_EXPERIMENT=0

# Set the STEAM_GAME property on the Chrome window if gamescope did not map it to the
# shortcut's panel by itself: auto, or 0 to never touch it.
TAG_WINDOW=auto

# Extra Chrome flags, space separated.
EXTRA_FLAGS=
